; Scenario for 11_hardware_designer (the environment is generated from board.achw)
;   asmsim examples/imu_gyro.asm --env examples/imu_env.cfg --scenario examples/imu_gyro.scn --vcd out.vcd
break peri:read_data
run until slot.valid max 100000000
expect_stop breakpoint                                   ; stopped on the breakpoint, before the 6-byte read
expect_pc peri read_data
delete 1
run until slot.valid max 100000000
expect slot.service_id == 1 :: the result is SID_IMU_GYRO_RAW
expect slot[0] == 0 && slot[1] == 10 :: gyro X raw = 10, high byte first (the order on the bus)
expect poll.ready == 1
run until csr[0x120] == 10 max 100000000
expect csr[0x120] == 10 :: corrected X committed to the CSR
expect peri.error == 0
log elapsed cycles checked next
expect now > 600000 && now < 1000000 :: I2C time dominates: every instruction is read from the I2C EEPROM first (fetch.read_mode = sequential), then the sensor transfers (spec 14.4)
