; Target profile of the IMU board demo. All values are PLANNING defaults except what is listed in `confirmed`.
; The Hardware Designer (Target profile) edits this file in place and keeps these comments.
profile_id = imu-board-demo   ; names the target in every artifact
main_move_depth = 64
main_branch_depth = 64
main_csr1_depth = 32
main_csrm_depth = 32
main_alu_depth = 64
peri_xfer1_depth = 32
peri_xferm_depth = 32
peri_pub_depth = 64
peri_branch_depth = 64
peri_csr1_depth = 32
device_map_depth = 8
max_code_bytes = 256
const_pool_max = 256
profile_cond0 = false
event_count = 8
event_dispatch = 2
event_eret = 2
csr_buf_valid = false
same_region_mov = true
ret_slot_base = 24
ret_stage_base = 30
layout_offset_bits = 16
sram_depth_words = 1024
main_image_base_word = 0
peri_image_base_word = 512
main_capacity_bytes = 2048
peri_capacity_bytes = 2048
main_pc_width = 8
peri_pc_width = 8
boot_pad_byte = 0
device_map_entry_bytes = 1
device_map_bus_shift = 7
device_map_addr_shift = 0
big_endian = false
scratchpad_reset_defined = false
csrbuf_reset_defined = false
peri_rx_reset_defined = false
br_cond = 1
cascade = 1
alu = 1
mul = 2
mov_setup = 1
mov_byte = 1
slot_consume_setup = 2
csr_access = 2
csr_byte = 2
csr_done = 1
pub_setup = 2
pub_byte = 1
xfer_issue = 2
cpu_hz = 27000000
i2c_hz = 400000
align_main_move = -1
align_main_branch = -1
align_main_csr1 = -1
align_main_csrm = -1
align_main_alu = -1
align_main_const = -1
align_peri_xfer1 = -1
align_peri_xferm = -1
align_peri_pub = -1
align_peri_branch = -1
align_peri_csr1 = -1
align_peri_devmap = -1
alu_arith_add = 0
alu_arith_sub = 1
alu_arith_mul = 2
alu_arith_inc = 3
alu_arith_dec = 4
alu_cmp_eq = 0
alu_cmp_ne = 1
alu_cmp_lt = 2
alu_cmp_ge = 3
alu_logic_and = 0
alu_logic_or = 1
alu_logic_xor = 2
alu_logic_not = 3

confirmed = pc_width    ; the PC width and code limit were checked against the RTL (made-up example)
