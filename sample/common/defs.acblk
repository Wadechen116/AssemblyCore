{
  "format": "acblk",
  "version": 1,
  "name": "defs",
  "output": "defs.inc",
  "next_id": 28,
  "sections": [
    {
      "domain": "",
      "x": 0,
      "y": 0,
      "blocks": [
        {
          "id": "b1",
          "type": "comment",
          "fields": {"text": "Shared definitions for the examples. The CSR addresses are EXAMPLE values: the spec names the CSRs but does not number them."}
        },
        {
          "id": "b2",
          "type": "directive",
          "fields": {"name": ".csr", "args": "AE_CTRL         = 0x010"}
        },
        {
          "id": "b3",
          "type": "directive",
          "fields": {"name": ".csr", "args": "GYRO_X_CORR_L   = 0x120"}
        },
        {
          "id": "b4",
          "type": "directive",
          "fields": {"name": ".csr", "args": "POLL_MASK       = 0x300"}
        },
        {
          "id": "b5",
          "type": "directive",
          "fields": {"name": ".csr", "args": "POLL_CTRL       = 0x301"}
        },
        {
          "id": "b6",
          "type": "directive",
          "fields": {"name": ".csr", "args": "PERI_CTRL       = 0x302"}
        },
        {
          "id": "b7",
          "type": "directive",
          "fields": {"name": ".csr", "args": "PERI_TPER       = 0x310"},
          "comment": "timer period, 2 bytes (low, high)"
        },
        {
          "id": "b8",
          "type": "directive",
          "fields": {"name": ".csr", "args": "PERI_TPER_H     = 0x311"}
        },
        {"id": "b9", "type": "blank"},
        {
          "id": "b10",
          "type": "directive",
          "fields": {"name": ".equ", "args": "POLL_CLEAR_W1P  = 0x01"}
        },
        {
          "id": "b11",
          "type": "directive",
          "fields": {"name": ".equ", "args": "POLL_ARM_W1P    = 0x02"}
        },
        {
          "id": "b12",
          "type": "directive",
          "fields": {"name": ".equ", "args": "PERI_DONE       = 0x01"}
        },
        {
          "id": "b13",
          "type": "directive",
          "fields": {"name": ".equ", "args": "PERI_ERROR_SET  = 0x02"}
        },
        {
          "id": "b14",
          "type": "directive",
          "fields": {"name": ".equ", "args": "PERI_TIMER_START = 0x08"}
        },
        {
          "id": "b15",
          "type": "directive",
          "fields": {"name": ".equ", "args": "PERI_RESET      = 0x04"},
          "comment": "clear poll / error / done latches at the start of a service (spec 13.2)"
        },
        {"id": "b16", "type": "blank"},
        {
          "id": "b17",
          "type": "comment",
          "fields": {"text": "which CSR bits mean what (lets the assembler check timer-start and poll-arm flows, W515 / W516)"}
        },
        {
          "id": "b18",
          "type": "directive",
          "fields": {"name": ".csrbit", "args": "POLL_CTRL[0] = poll_clear"}
        },
        {
          "id": "b19",
          "type": "directive",
          "fields": {"name": ".csrbit", "args": "POLL_CTRL[1] = poll_arm"}
        },
        {
          "id": "b20",
          "type": "directive",
          "fields": {"name": ".csrbit", "args": "PERI_CTRL[3] = timer_start"}
        },
        {"id": "b21", "type": "blank"},
        {
          "id": "b22",
          "type": "comment",
          "fields": {"text": "service result contract ids: one allocation plan shared by Main and Peri (spec 10.3)"}
        },
        {
          "id": "b23",
          "type": "directive",
          "fields": {"name": ".service", "args": "SID_IMU_GYRO_RAW = 1, len=6, big"},
          "comment": "X_hi X_lo Y_hi Y_lo Z_hi Z_lo: the sensor sends the high byte first"
        },
        {
          "id": "b24",
          "type": "directive",
          "fields": {"name": ".service", "args": "SID_TEMP_RAW     = 2"}
        },
        {"id": "b25", "type": "blank"},
        {
          "id": "b26",
          "type": "comment",
          "fields": {"text": "DeviceMap: physical endpoints used by EXEC_XFER.dev_sel"}
        },
        {
          "id": "b27",
          "type": "directive",
          "fields": {"name": ".devmap", "args": "0, I2C, 0x68, DEV_IMU"}
        }
      ]
    }
  ]
}
